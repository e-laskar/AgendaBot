<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Pas d'exécutable natif (.exe) : on lance via "dotnet <projet>.dll", portable Windows/WSL. -->
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>

  <PropertyGroup>
    <UseArtifactsOutput>true</UseArtifactsOutput>
    <ArtifactsPath Condition="$([MSBuild]::IsOSPlatform('Windows'))">$(MSBuildThisFileDirectory).artifacts/windows</ArtifactsPath>
    <ArtifactsPath Condition="!$([MSBuild]::IsOSPlatform('Windows'))">$(MSBuildThisFileDirectory).artifacts/linux</ArtifactsPath>
  </PropertyGroup>

</Project>
