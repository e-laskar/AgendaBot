# Copier ce fichier en .env (ignoré par git) et renseigner les valeurs.
# Les variables déjà définies dans l'environnement sont prioritaires sur ce fichier.
# "__" (double underscore) remplace ":" des sections de configuration.

# Environnement d'exécution (Development active les user-secrets)
DOTNET_ENVIRONMENT=Development

# --- Discord ---
Discord__Token=
# ID du serveur de test (enregistrement instantané des commandes). Laisser vide en production.
# Discord__DevGuildId=123456789012345678
Discord__TimeZone=Europe/Paris
Discord__ReminderMinutesBefore=15

# --- Base de données (dev local, hors Docker) ---
# Sqlite (défaut) ou Postgres
Database__Provider=Sqlite
ConnectionStrings__Agenda=Data Source=agenda.db
# Exemple Postgres local :
# Database__Provider=Postgres
# ConnectionStrings__Agenda=Host=localhost;Port=5432;Database=agenda;Username=agenda;Password=changeme

# --- PostgreSQL (docker compose) ---
# Utilisés par le service "db" et pour construire la chaîne de connexion du bot dans compose.yaml.
POSTGRES_DB=agenda
POSTGRES_USER=agenda
POSTGRES_PASSWORD=changeme
